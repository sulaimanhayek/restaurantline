# ===========================================================================
#  restaurantline
# ===========================================================================
#  Every variable below is documented inline. Nothing in this file needs to
#  change for `docker compose up` to give you a working, fully explorable app —
#  all four outbound integrations default to fake drivers that require no
#  credentials and make no network calls.
#
#  Sections marked  [REAL CALLS]  are the ones to fill in when you are ready to
#  put the agent on an actual phone line.
# ===========================================================================


# ---------------------------------------------------------------------------
#  Application
# ---------------------------------------------------------------------------

APP_NAME=restaurantline

# local | production. Leave as `local` for development; `production` disables
# the debug page and enables config caching.
APP_ENV=local

# Generated automatically on first boot by the container entrypoint.
# Generate manually with: php artisan key:generate
APP_KEY=

# Never true in production. The agent endpoints never leak stack traces to
# callers regardless, but the dashboard would.
APP_DEBUG=true

# The public URL of this application. This one matters more than it looks:
# `kitchenline:provision` bakes this into the tool definitions it registers with
# ElevenLabs, so the agent will call exactly this host. When testing locally with
# ngrok, set this to your ngrok URL *before* provisioning — see the ngrok section
# of the README.
APP_URL=http://localhost:8000

# Host port the app is published on. Change if 8000 is taken.
APP_PORT=8000

# Fallback timezone. The seeded restaurant carries its own timezone, and all
# opening-hours logic uses the restaurant's, not this one. Leave as UTC.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

# Set false to skip seeding the demo restaurant on container boot — useful once
# you have replaced the sample menu with a real one.
RESTAURANTLINE_SEED_ON_BOOT=true


# ---------------------------------------------------------------------------
#  Database — PostgreSQL
# ---------------------------------------------------------------------------
#  `postgres` is the compose service name. Change DB_HOST to 127.0.0.1 only if
#  you are running the app outside Docker against the published port.

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=restaurantline
DB_USERNAME=restaurantline
DB_PASSWORD=secret

# Host port PostgreSQL is published on, for connecting with psql or a GUI.
DB_PORT_FORWARD=5432

# The interface Docker publishes PostgreSQL, Redis and Mailpit on. Loopback by
# default: the password above is `secret`, Redis has no password at all, and
# Mailpit shows every message the application sends, none of which should be one
# `docker compose up` away from the rest of the coffee shop. Set 0.0.0.0 only if
# you genuinely want to reach them from another machine. The app itself and
# Reverb are published normally — they are the surface that is meant to exist.
DOCKER_BIND_ADDRESS=127.0.0.1


# ---------------------------------------------------------------------------
#  Redis, queues, cache and sessions
# ---------------------------------------------------------------------------

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PORT_FORWARD=6379

# Horizon manages the queue workers; the connection must be redis for it to work.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120


# ---------------------------------------------------------------------------
#  Broadcasting — Laravel Reverb (kitchen display)
# ---------------------------------------------------------------------------
#  These defaults work out of the box in Docker. The app and key below are
#  local-only placeholders; generate real ones for production with
#  `php artisan reverb:install`.

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=restaurantline
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret

# Where the *server* binds (inside the container).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Where the *browser* connects. Differs from the above because the browser is
# outside Docker. In production both become your public wss:// host.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

VITE_PORT=5173

# The display re-queries on this interval whenever it cannot hear the
# websocket, which is also the whole story before you run `npm run build`.
KITCHEN_POLL_SECONDS=15

# Share of an order's promised prep time after which its timer turns amber.
KITCHEN_WARN_AT_PERCENT=75


# ---------------------------------------------------------------------------
#  Agent tool endpoint authentication
# ---------------------------------------------------------------------------
#  The nine tool endpoints under /api/agent are protected by a static bearer
#  token. ElevenLabs sends it as an `Authorization: Bearer <token>` request
#  header.
#
#  The token itself is never written into a tool definition. `kitchenline:provision`
#  uploads `Bearer <token>` once as an ElevenLabs workspace secret and points all
#  nine tools at it by id, so it appears in plaintext in nobody's dashboard.
#
#  Generate a strong one before going live:
#      php -r "echo bin2hex(random_bytes(32));"
#
#  The value below is published in this repository, so it is a convenience and
#  not a credential. Every agent endpoint refuses it outright when APP_ENV is
#  production, and `kitchenline:provision` warns while there is still time; an
#  install that reached production still using it would otherwise have an open
#  order-creation endpoint that looked configured.
#
#  Rotating it is two steps: change it here, then re-run `kitchenline:provision`,
#  which overwrites the stored secret. The tools do not move.

AGENT_API_TOKEN=local-development-agent-token-change-me

# Requests per minute allowed per conversation against the agent endpoints. A
# single call makes maybe a dozen tool calls, so this is generous; it exists to
# bound damage from a looping agent or a leaked token, not to shape normal
# traffic. A global ceiling of ten times this value applies across all calls.
AGENT_RATE_LIMIT_PER_MINUTE=120

# How long a sealed address from /address/validate can still be used to create
# an order, in seconds. It only has to outlive one phone call.
AGENT_ADDRESS_TOKEN_TTL=3600


# ---------------------------------------------------------------------------
#  ElevenLabs                                                    [REAL CALLS]
# ---------------------------------------------------------------------------
#  Driver:
#    fake — no network. Provisioning prints what it *would* send and stores
#           deterministic fake ids. This is the default so the repo is usable
#           and testable with no account.
#    api  — talks to the real ElevenLabs API.

ELEVENLABS_DRIVER=fake

# From https://elevenlabs.io/app/settings/api-keys — sent as the `xi-api-key`
# request header.
ELEVENLABS_API_KEY=

ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# The LLM the agent runs on. See the create-agent API reference for the current
# list of accepted values.
ELEVENLABS_AGENT_LLM=gpt-4o-mini

# Voice for the agent. Leave blank to use the account default.
ELEVENLABS_VOICE_ID=

# Text-to-speech model. Flash, because on a phone call latency *is* the
# experience. Any of the eleven_* conversational models is accepted.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# The language the agent speaks, as an ISO 639-1 code.
ELEVENLABS_AGENT_LANGUAGE=en

# Ceiling on a single call, in seconds. Not a feature — a limit on what one
# stuck conversation can cost.
ELEVENLABS_MAX_CALL_SECONDS=600

# Seconds allowed for one API request. Only the provisioning commands spend
# this, and a person is watching them, so it is generous: a timeout halfway
# through registering nine tools is more annoying than a slow response.
ELEVENLABS_TIMEOUT=30

# Shared secret for verifying post-call webhooks. `kitchenline:provision` creates
# the webhook and prints this once, in a box you cannot miss; ElevenLabs will not
# show it again. Copy it here.
#
# Without it the post-call webhook rejects every delivery — by design, since a
# webhook that accepts unsigned posts is an endpoint anybody can write
# conversations into.
#
# Verification: the `ElevenLabs-Signature` header carries `t=<unix>,v0=<hex>`,
# where the hex is HMAC-SHA256 of "<timestamp>.<raw request body>". Requests
# whose timestamp is older than the tolerance below are rejected.
ELEVENLABS_WEBHOOK_SECRET=

# Seconds of clock skew tolerated on the webhook timestamp. ElevenLabs' own
# reference implementations use 1800 (30 minutes).
ELEVENLABS_WEBHOOK_TOLERANCE=1800

# Filesystem disk that call recordings are written to. Local by default so a
# fresh clone needs no cloud account. Point this at s3 before a real restaurant
# uses it — recordings are the largest thing stored here and the one thing that
# cannot be regenerated.
ELEVENLABS_AUDIO_DISK=local


# ---------------------------------------------------------------------------
#  Twilio                                                        [REAL CALLS]
# ---------------------------------------------------------------------------
#  restaurantline does not talk to Twilio for voice — ElevenLabs owns the phone
#  leg via its native Twilio integration, which you configure in the ElevenLabs
#  dashboard. These credentials are only used for outbound SMS (order
#  confirmations and payment links).
#
#  Prefer an API Key SID/Secret over your account-wide auth token.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The number callers are transferred to when they ask for a human. Surfaced by
# the /api/agent/escalate tool. E.164 format.
RESTAURANT_TRANSFER_NUMBER=


# ---------------------------------------------------------------------------
#  SMS                                                           [REAL CALLS]
# ---------------------------------------------------------------------------
#  log    — writes the message to the Laravel log, and to the SMS list in the
#           dashboard, exactly as the customer would have received it.
#           Default; no credentials, nothing sent, nothing billed.
#  twilio — sends for real using the Twilio credentials above.

SMS_DRIVER=log

# Seconds to wait on the provider. Short on purpose: this runs on a queue
# behind a call that has already ended, and a worker blocked on a hung provider
# is a worker not sending anybody else's confirmation.
SMS_TIMEOUT=10


# ---------------------------------------------------------------------------
#  Geocoding                                                     [REAL CALLS]
# ---------------------------------------------------------------------------
#  fake   — deterministic in-memory geocoder seeded with addresses around the
#           demo restaurant, including deliberately ambiguous and
#           out-of-radius ones. Default; no credentials, and what the tests use.
#  google — Google Geocoding API.
#
#  Address validation is the single highest-risk step in a voice order. Read
#  the address-handling section of the README before switching to a real
#  provider.

GEOCODER_DRIVER=fake

GOOGLE_MAPS_API_KEY=

# Bias results toward one country. ISO 3166-1 alpha-2, or blank for no bias.
GEOCODER_REGION_BIAS=GB

# Candidates below this confidence (0.0–1.0) are never offered to the caller.
GEOCODER_MIN_CONFIDENCE=0.4

# At or above this, the agent reads the address back once and takes a yes.
GEOCODER_CONFIDENT_THRESHOLD=0.8

# If the runner-up is within this of the best candidate, they are too alike to
# separate ("Brick Lane" with no house number) and the agent asks instead.
GEOCODER_AMBIGUITY_MARGIN=0.05

# How many candidates to offer at most. Nobody can hold five addresses in their
# head over the phone.
GEOCODER_MAX_CANDIDATES=3

# Seconds to wait on the provider. A caller is on the line; a slow lookup is a
# failed one.
GEOCODER_TIMEOUT=8


# ---------------------------------------------------------------------------
#  Menu matching
# ---------------------------------------------------------------------------
#  How "erm, the peri peri chicken thing" becomes a row in the menu table.
#  Scores run 0.0–1.0 and come from a blend of two PostgreSQL trigram metrics —
#  see docs/DECISIONS.md #0013.
#
#  These are the numbers to tune against a real client's menu, and the Phase 9
#  eval harness (`php artisan kitchenline:eval`) is how you tell whether a
#  change helped. Raising the confident threshold makes the agent ask more
#  often; lowering it makes it assume more often.

# Below this, an item is not a candidate at all.
MENU_MATCH_MINIMUM_CONFIDENCE=0.3

# At or above this, the item is added without checking first.
MENU_MATCH_CONFIDENT_THRESHOLD=0.62

# If the runner-up is within this of the best match, the agent asks which.
MENU_MATCH_AMBIGUITY_MARGIN=0.08

# How many alternatives to keep. Read aloud, three is already a lot.
MENU_MATCH_MAX_RESULTS=5


# ---------------------------------------------------------------------------
#  Pricing
# ---------------------------------------------------------------------------
#  The restaurant's minimum order value, delivery fees and free-delivery
#  thresholds are per-restaurant data, not config — set them in the dashboard.
#  This is the one policy that is not.

# By default the minimum order value applies to delivery only: almost no
# takeaway turns away a customer standing at the counter for spending too
# little. Set true to apply it to collection as well.
PRICING_MINIMUM_APPLIES_TO_COLLECTION=false


# ---------------------------------------------------------------------------
#  Payments                                                      [REAL CALLS]
# ---------------------------------------------------------------------------
#  !! restaurantline NEVER accepts card details over the phone. !!
#
#  The agent cannot take a card number, and there is no endpoint that would
#  accept one. Payment is either cash on delivery, or a link sent by SMS after
#  the call ends. This is deliberate — reading a card number to a voice agent
#  puts the recording, the transcript and your logs inside PCI DSS scope, and
#  no amount of redaction reliably gets you back out. See
#  app/Services/Payments/README.md.
#
#  fake   — links to a page in this application showing the total and a button
#           that marks the order paid. Default. It works offline and with no
#           account, so the whole path — link created, text sent, customer taps
#           it, order goes green — can be walked on a laptop. It refuses to run
#           in production.
#  stripe — creates a real Stripe Checkout Session. The card number is typed
#           into Stripe's own hosted page by the customer and never reaches
#           this server, which is what keeps you inside SAQ A.

PAYMENT_DRIVER=fake

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Seconds to wait on the payment provider.
PAYMENT_TIMEOUT=15

# How far out of step with Stripe's clock a webhook may be before it is treated
# as a replay and rejected. Stripe's own recommendation is 300.
STRIPE_WEBHOOK_TOLERANCE=300

# The fake driver hands out links to a page that marks orders paid, which is
# exactly what you want on a laptop and exactly what you do not want facing the
# internet — so it refuses to run in production unless this is set. The only
# honest reason to set it is a restaurant that takes no card payments at all.
PAYMENTS_ALLOW_FAKE_IN_PRODUCTION=false

# Point a Stripe webhook endpoint at https://your-host/webhooks/stripe and
# subscribe it to checkout.session.completed and checkout.session.expired. The
# signature is verified before anything else runs; an unset secret rejects
# everything rather than letting it through.


# ---------------------------------------------------------------------------
#  Evals
# ---------------------------------------------------------------------------
#  fake — replays recorded fixtures from evals/fixtures. Costs nothing, needs no
#         keys, and is what CI runs.
#  live — drives the real agent. Costs money per scenario.

EVAL_MODE=fake

# LLM used to play the caller in live mode. Ignored entirely in fake mode.
EVAL_CALLER_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=


# ---------------------------------------------------------------------------
#  Mail — Mailpit catches everything locally
# ---------------------------------------------------------------------------

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="orders@restaurantline.test"
MAIL_FROM_NAME="${APP_NAME}"

MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025


# ---------------------------------------------------------------------------
#  Logging
# ---------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

FILESYSTEM_DISK=local
